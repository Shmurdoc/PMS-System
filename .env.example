# Copy to .env before `docker compose up`. Never commit the real .env.

# Long, random. Used for the Postgres superuser inside the compose network.
POSTGRES_PASSWORD=change-me-long-random

# JWT signing key, minimum 32 characters, random (e.g. `openssl rand -base64 48`).
JWT_KEY=change-me-32+-character-random-string

# Seeds the three demo logins (admin/manager/front @nexus.com). Set false
# once you have real users — see DEPLOY.md.
SEED_DEMO_USERS=true

# Host port for the Postgres port mapping (loopback only; 5432 is often taken).
AQURI_DB_HOST_PORT=5433
