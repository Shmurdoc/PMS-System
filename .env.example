# Copy to .env and fill in real values. docker compose reads .env automatically.
POSTGRES_PASSWORD=change-me
JWT_KEY=change-me-at-least-32-characters-long
# Seed the demo logins (admin@nexus.com etc.) on first boot. Set false for real deployments.
SEED_DEMO_USERS=true
# Host port published for Postgres. Defaults to 5433 because a native PostgreSQL
# service commonly owns 5432. Container-internal traffic always uses 5432.
AQURI_DB_HOST_PORT=5433
